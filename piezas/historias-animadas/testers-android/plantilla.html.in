<!doctype html>
<!-- PLANTILLA. No se renderiza: preparar.py escribe index.html con los textos del idioma que
     se le pida. Lo que se toca a mano es esto y la tabla TEXTOS de preparar.py. -->
<html lang="{{lang}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <title>Nomad · testers de Android ({{lang}})</title>
    <link rel="stylesheet" href="assets/fuentes.css" />
    <script src="assets/gsap.min.js"></script>
    <style>
      html, body { margin: 0; padding: 0; background: #100E0B; }
      .serif { font-family: 'Instrument Serif'; font-weight: 400; }
      .sans  { font-family: 'Instrument Sans'; }

      /* LA HISTORIA PARA BUSCAR TESTERS DE ANDROID (26-oct). Decisiones en README.md. Al tocarla:
         - Zona segura de historia: todo el texto entre y=280 e y=1500; de 1520 para abajo no hay
           nada, que ahí va el adhesivo de enlace.
         - La foto, a sangre y QUIETA. Detrás del texto, una banda oscura, no un velo entero.
         - La pantalla es de la app real, sin barra de estado y SIN marco de móvil.
         - Lo que dice el fotograma 0 (la marca y «¿Tienes Android?») está ahí desde el principio. */
      #root { position: relative; width: 1080px; height: 1920px; overflow: hidden;
              color: #FFFDF9; background: #100E0B; }
      #foto { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; display: block; object-fit: cover; }
      #banda { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px;
        background: linear-gradient(180deg, rgba(16,14,11,.86) 0%, rgba(16,14,11,.80) 30%, rgba(16,14,11,.55) 46%,
                                            rgba(16,14,11,.30) 62%, rgba(16,14,11,.30) 80%, rgba(16,14,11,.45) 100%); }

      /* La marca: el icono de la app y «Nomad · Android». */
      #icono { position: absolute; left: 84px; top: 290px; width: 76px; height: 76px; display: block;
               border-radius: 17px; box-shadow: 0 10px 30px rgba(0,0,0,.35); }
      #marca { position: absolute; left: 182px; top: 298px; margin: 0; font-size: 40px; line-height: 40px;
               font-weight: 700; white-space: nowrap; }
      #plataforma { position: absolute; left: 182px; top: 342px; margin: 0; font-size: 28px; line-height: 28px;
                    font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: rgba(255,253,249,.78);
                    white-space: nowrap; }

      .tit { position: absolute; left: 84px; margin: 0; width: 912px; letter-spacing: -.02em; white-space: nowrap;
             text-shadow: 0 4px 34px rgba(0,0,0,.5); }
      #t1 { top: 404px; font-size: 118px; line-height: 1.0; }
      #t2 { top: 534px; font-size: 92px; line-height: 1.0; }
      #t3 { top: 630px; font-size: 92px; line-height: 1.0; }
      .menta { color: #5CC0A6; }
      .linea { position: absolute; left: 84px; margin: 0; width: 912px; font-size: 38px; line-height: 48px;
               font-weight: 500; color: rgba(255,253,249,.92); white-space: nowrap; text-shadow: 0 2px 18px rgba(0,0,0,.6); }
      #l1 { top: 748px; }
      #l2 { top: 796px; }

      /* LA PANTALLA: el día del viaje a Roma, tal cual sale en la app, flotando. Sólo en los idiomas
         con una captura REAL (preparar.py, PANTALLA); sin ella, se ve el Coliseo. */
      #pantalla { position: absolute; left: 230px; top: 862px; width: 620px; height: {{alto_pantalla}}px;
                  border-radius: 40px; overflow: hidden; background: #F5F0E8;
                  box-shadow: 0 50px 120px rgba(0,0,0,.55), 0 10px 30px rgba(0,0,0,.25); }
      #pantalla img { display: block; width: 620px; }

      /* EL GANCHO: en menta, encima del pie de la pantalla (sin tapar «Iniciar tour»). */
      #gancho { position: absolute; left: 132px; top: 1244px; width: 816px; height: 124px; box-sizing: border-box;
                border-radius: 30px; background: #5CC0A6; color: #0E2D27;
                box-shadow: 0 24px 60px rgba(0,0,0,.40); }
      .g { position: absolute; left: 0; width: 816px; margin: 0; text-align: center; font-size: 42px; line-height: 48px;
           font-weight: 700; white-space: nowrap; }
      #g1 { top: 14px; }
      #g2 { top: 62px; }

      /* «TOCA "ÚNETE A LA PRUEBA"»: nombra el adhesivo con su texto, y debajo, FUERA de la cápsula, dos
         chevrones que botan hacia él. Dentro de la cápsula un chevrón parecía un desplegable (revisión
         del 26-oct). La cápsula es oscura para leerse sobre cualquier parte de la foto. Lo más bajo
         del rebote (la punta del segundo chevrón) llega a y≈1510: de 1520 para abajo no hay nada. */
      #toca { position: absolute; left: 0; top: 1380px; width: 1080px; height: 60px; text-align: center; }
      #toca-txt { display: inline-block; margin: 0; height: 60px; padding: 0 40px; box-sizing: border-box;
                  border-radius: 30px; background: rgba(16,14,11,.80);
                  font-size: 32px; line-height: 60px; font-weight: 600; white-space: nowrap; }
      #flecha { position: absolute; left: 510px; top: 1440px; width: 60px; height: 50px; }
      /* Los chevrones van girados por CSS y NO se animan: lo que bota es #flecha, su envoltorio. */
      .chevron { position: absolute; left: 12px; width: 28px; height: 28px;
                 border-right: 8px solid #5CC0A6; border-bottom: 8px solid #5CC0A6; transform: rotate(45deg);
                 filter: drop-shadow(2px 2px 4px rgba(0,0,0,.7)); }
      #ch1 { top: -14px; opacity: .55; }
      #ch2 { top: 6px; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="{{id}}" data-start="0"
         data-width="1080" data-height="1920" data-duration="10">

      <img id="foto" src="assets/fondo-coliseo.jpg" alt="" />
      <div id="banda"></div>

      <img id="icono" src="assets/icono-app.png" alt="" />
      <p id="marca" class="sans">Nomad</p>
      <p id="plataforma" class="sans">{{plataforma}}</p>

      <h1 id="t1" class="tit serif">{{t1}}</h1>
      <h1 id="t2" class="tit serif">{{t2}}</h1>
      <h1 id="t3" class="tit serif"><span class="menta">{{t3}}</span></h1>

      <p id="l1" class="linea sans">{{l1}}</p>
      <p id="l2" class="linea sans">{{l2}}</p>

      <!-- PANTALLA -->
      <div id="pantalla"><img src="assets/{{pantalla}}" alt="" /></div>
      <!-- /PANTALLA -->

      <div id="gancho">
        <p id="g1" class="g sans">{{g1}}</p>
        <p id="g2" class="g sans">{{g2}}</p>
      </div>

      <div id="toca"><p id="toca-txt" class="sans">{{toca}}</p></div>
      <div id="flecha"><div id="ch1" class="chevron"></div><div id="ch2" class="chevron"></div></div>
    </div>
    <script>
      // Una sola línea de tiempo, pausada, registrada DESPUÉS de que carguen las fuentes.
      // Estado inicial dentro del fromTo, nunca en CSS. Nada se funde encima de otra cosa: entra
      // moviéndose y queda opaco. Todo quieto desde ~5 s (~4 s sin pantalla) salvo la flecha, para leer y tocar.
      document.fonts.ready.then(function () {
        var tl = gsap.timeline({ paused: true });
        var IN = { autoAlpha: 1, y: 0, duration: 0.5, ease: "power3.out" };
        // 0: la foto, la marca y «¿Tienes Android?» ya están (primer vistazo y portada).
        tl.fromTo("#t2", { autoAlpha: 0, y: 26 }, IN, 0.35);
        tl.fromTo("#t3", { autoAlpha: 0, y: 26 }, IN, 0.6);
        tl.fromTo("#l1", { autoAlpha: 0, y: 16 }, IN, 1.25);
        tl.fromTo("#l2", { autoAlpha: 0, y: 16 }, IN, 1.4);
        // La pantalla sube opaca desde fuera del cuadro: visible desde su primer fotograma.
        if (document.querySelector("#pantalla")) {
          tl.fromTo("#pantalla", { autoAlpha: 0, y: 1100 }, { autoAlpha: 1, duration: 0 }, 1.9);
          tl.fromTo("#pantalla", { y: 1100 }, { y: 0, duration: 0.9, ease: "expo.out", immediateRender: false }, 1.9);
        }
        // El gancho, con un golpe pequeño.
        tl.fromTo("#gancho", { autoAlpha: 0, scale: 0.9, y: 20 },
                  { autoAlpha: 1, scale: 1, y: 0, duration: 0.55, ease: "back.out(1.6)" }, {{t_gancho}});
        tl.fromTo("#toca", { autoAlpha: 0, y: 18 }, IN, {{t_toca}});
        tl.fromTo("#flecha", { autoAlpha: 0, y: -10 }, { autoAlpha: 1, y: 0, duration: 0.3, ease: "power2.out" }, {{t_toca}} + 0.2);
        // Los chevrones botan hacia el adhesivo hasta el final: 0,5 s abajo, 0,5 s arriba, 20 px.
        tl.fromTo("#flecha", { y: 0 }, { y: 20, duration: 0.5, ease: "sine.inOut", yoyo: true, repeat: {{rep_flecha}},
                  immediateRender: false }, {{t_flecha}});
        tl.set({}, {}, 10);

        window.__timelines["{{id}}"] = tl;
        if (window.__hfForceTimelineRebind) window.__hfForceTimelineRebind();
      });
    </script>
  </body>
</html>
